<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoomscrollWrapped.ViewModels"
             x:Class="DoomscrollWrapped.Views.WastedOnScrollPage"
             x:DataType="vm:WastedOnScrollViewModel"
             BackgroundColor="#121212"
             FlowDirection="LeftToRight">
    <Grid RowDefinitions="*" ColumnDefinitions="*">
    <ScrollView Grid.Row="0" Grid.Column="0">
        <VerticalStackLayout
            Padding="30,50"
            Spacing="30">

            <Label
                Text="Wasted on Scroll"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalOptions="Center" />

            <Label
                Text="All-Time Stats"
                FontSize="16"
                TextColor="#AAAAAA"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="#FF6B6B"
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

            <Grid
                IsVisible="{Binding IsResultsVisible}"
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                ColumnDefinitions="Auto, *"
                RowSpacing="15"
                ColumnSpacing="15"
                Margin="0, 10, 0, 0">

                <Label Grid.Row="0" Grid.Column="0" Text="📱" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding TikTokText}" TextColor="#FF0050" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="📸" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="{Binding InstagramText}" TextColor="#E1306C" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="2" Grid.Column="0" Text="▶️" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="2" Grid.Column="1" Text="{Binding YouTubeText}" TextColor="#FF0000" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="{Binding TotalTimeText}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"
                    HorizontalOptions="Center" />

                <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="------------------------" TextColor="#666666" HorizontalOptions="Center" />

                <Label Grid.Row="5" Grid.Column="0" Text="📚" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="5" Grid.Column="1" Text="{Binding BooksText}" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="6" Grid.Column="0" Text="💸" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="6" Grid.Column="1" Text="{Binding MoneyText}" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="7" Grid.Column="0" Text="🏋️" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="7" Grid.Column="1" Text="{Binding GymText}" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="8" Grid.Column="0" Text="🎯" FontSize="24" VerticalOptions="Center" />
                <Label Grid.Row="8" Grid.Column="1" Text="{Binding SkillText}" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#8B0000"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
