<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoomscrollWrapped.Views.MainPage"
             BackgroundColor="#121212"
             FlowDirection="LeftToRight">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="30"
            HorizontalOptions="Center">

            <Label
                Text="Doomscroll Wrapped"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalOptions="Center" />

            <Grid 
                x:Name="ResultsGrid" 
                IsVisible="False" 
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" 
                ColumnDefinitions="Auto, *" 
                RowSpacing="15" 
                ColumnSpacing="15"
                Margin="0, 10, 0, 0">

                <!-- Overall App Time Context -->
                <Label Grid.Row="0" Grid.Column="0" Text="📱" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="TikTokLabel" Grid.Row="0" Grid.Column="1" TextColor="#FF0050" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="📸" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="InstagramLabel" Grid.Row="1" Grid.Column="1" TextColor="#E1306C" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="2" Grid.Column="0" Text="▶️" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="YouTubeLabel" Grid.Row="2" Grid.Column="1" TextColor="#FF0000" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />

                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="------------------------" TextColor="#666666" HorizontalOptions="Center" />

                <!-- Regret Values -->
                <Label Grid.Row="4" Grid.Column="0" Text="📚" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="BooksLabel" Grid.Row="4" Grid.Column="1" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="5" Grid.Column="0" Text="💸" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="MoneyLabel" Grid.Row="5" Grid.Column="1" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="6" Grid.Column="0" Text="🏋️" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="GymLabel" Grid.Row="6" Grid.Column="1" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />

                <Label Grid.Row="7" Grid.Column="0" Text="🎯" FontSize="24" VerticalOptions="Center" />
                <Label x:Name="SkillLabel" Grid.Row="7" Grid.Column="1" TextColor="#FFFFFF" FontSize="16" VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="True" IsVisible="True" Color="#8B0000" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
